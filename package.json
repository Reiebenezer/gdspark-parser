{
  "name": "@reiebenezer/gdspark-parser",
  "version": "0.1.6",
  "description": "GDSpark command lexer/parser library",
  "type": "module",
  "private": false,
  "main": "./dist/index.ts",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lexer": {
      "types": "./dist/lexer.d.ts",
      "import": "./dist/lexer.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gdspark",
    "gds",
    "interpreter",
    "frontend"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}